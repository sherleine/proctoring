+                               [sp("S1", [(0.0, 4.5)], rms=-14.0), sp("S2", [(4.5, 10.0)], rms=-34.0)])
+    p = run(store_root, clip, result)
+    assert roles(p) == {"S1": "main", "S2": "background"}
+    assert "BACKGROUND_CONVERSATION_DETECTED" in review(p)

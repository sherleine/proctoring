# Copy to .env in the repository root:  Copy-Item .env.example .env
# All three applications read this single file.
# Values marked (browser) are bundled into the frontend - never put secrets in them.

# ---------------------------------------------------------------- Frontend (browser)
# Empty = call /api on the same origin; the Vite dev server proxies it to the backend.
# Set e.g. http://localhost:8000 to call the backend directly (CORS_ORIGINS must allow the frontend).
VITE_API_BASE_URL=
FRONTEND_PORT=5173
# Request microphone and start monitoring as soon as the page opens.
VITE_AUTO_START=true
VITE_ECHO_CANCELLATION=true
VITE_NOISE_SUPPRESSION=true
VITE_AUTO_GAIN_CONTROL=true
# Webcam (ideal values; the browser picks the closest the camera supports)
VITE_VIDEO_WIDTH=1280
VITE_VIDEO_HEIGHT=720
VITE_VIDEO_FRAME_RATE=30
VITE_VIDEO_BITRATE=1500000

# ---------------------------------------------------------------- Event-based recording (browser)
# A clip is saved only when Silero VAD detects speech.
# Silence (ms) that ends an event; shorter pauses are merged into the same clip.
EVENT_SILENCE_MS=1500
# Footage (ms) kept after the last speech.
EVENT_POST_SPEECH_MS=1000
# Longer speech is split into consecutive clips of at most this many seconds.
EVENT_MAX_DURATION=60
# Sounds with less confident speech than this (ms) are ignored.
VITE_VAD_MIN_SPEECH_MS=250
VITE_VAD_START_THRESHOLD=0.5
VITE_VAD_END_THRESHOLD=0.35

# ---------------------------------------------------------------- Shared audio contract (browser + services)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
# seconds
MAX_CLIP_DURATION=10
# seconds of video+audio kept before speech onset (rolling buffer)
PRE_SPEECH_BUFFER=2
# milliseconds of sustained silence that ends a speech event
SILENCE_DURATION=700

# ---------------------------------------------------------------- Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8001
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# ---------------------------------------------------------------- AI service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
TORCH_NUM_THREADS=4
# Never log transcription text unless debugging locally.
LOG_TRANSCRIPTS=false

# VAD (server-side verification)
VAD_PROVIDER=silero

# Transcription
TRANSCRIPTION_PROVIDER=faster_whisper
# tiny | base | small | medium | large-v3 (downloaded from Hugging Face on first start, no token needed)
WHISPER_MODEL=base
# cpu | cuda | auto  (cuda needs cuBLAS + cuDNN 9 for CTranslate2 - see README)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Diarization (pyannote models are gated: accept the terms on Hugging Face and set HF_TOKEN)
DIARIZATION_ENABLED=true
DIARIZATION_PROVIDER=pyannote
PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1
HF_TOKEN=

# Environmental audio classification
AUDIO_CLASSIFICATION_ENABLED=true
AUDIO_CLASSIFICATION_PROVIDER=yamnet

# Company LLM (optional; the pipeline falls back to rule-based analysis when disabled/unreachable)
LLM_ENABLED=false
LLM_PROVIDER=company_local
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

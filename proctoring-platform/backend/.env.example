# Backend (.NET) settings. Copy to backend/.env:   Copy-Item backend/.env.example backend/.env
# In Development the API loads the nearest .env above its working directory (backend/.env, else the
# repository root .env). Real environment variables always win. Never commit .env files.

# ---------------------------------------------------------------- HTTP
ASPNETCORE_URLS=http://0.0.0.0:5080
CORS_ORIGINS=http://localhost:5173
# json (structured, one object per line) or text
LOG_FORMAT=json

# ---------------------------------------------------------------- Database (SQLite, source of truth)
# Relative paths resolve against backend/src/Proctoring.Api (where `dotnet ef` also runs)
DATABASE_PATH=data/db/proctoring.db
DATABASE_MIGRATE_ON_START=true

# ---------------------------------------------------------------- Sessions
SESSION_MAX_DURATION_HOURS=6
SESSION_TOKEN_TTL_AFTER_END_HOURS=24
SESSION_IDEMPOTENCY_WINDOW_MINUTES=60
SESSION_UPLOAD_GRACE_SECONDS=120
# Base64 of >= 32 random bytes. REQUIRED outside Development.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
SESSION_TOKEN_SECRET=

# ---------------------------------------------------------------- Recording policy (served to the browser)
RECORDING_PRE_EVENT_SECONDS=2.5
RECORDING_SILENCE_SECONDS=1.5
RECORDING_MAX_EVENT_SECONDS=10
RECORDING_SPLIT_OVERLAP_SECONDS=1
RECORDING_UPLOAD_VIDEO=false
RECORDING_MAX_UPLOAD_BYTES=2000000

# ---------------------------------------------------------------- Audio events
# Audio store root (relative to backend/src/Proctoring.Api). The processing service mounts the same store
# and resolves audioRef.key against its own AUDIO_STORE_PATH.
AUDIO_STORE_PATH=data/audio
AUDIO_RETENTION_HOURS=24
# Candidate voice reference (biometric) is deleted this long after its last update
VOICEPRINT_RETENTION_HOURS=24
AUDIO_MIN_DURATION_SECONDS=0.1
AUDIO_DURATION_TOLERANCE_SECONDS=0.2
EVENT_CLOCK_SKEW_SECONDS=300
# Background job: re-publish RECEIVED events (outbox), fail events whose audio never arrived, clean staging,
# retention, prune the live-update log
EVENT_MAINTENANCE_ENABLED=true
EVENT_MAINTENANCE_INTERVAL_SECONDS=30
EVENT_REPUBLISH_AFTER_SECONDS=15
EVENT_MISSING_AUDIO_AFTER_MINUTES=10
EVENT_STAGING_MAX_AGE_MINUTES=60

# ---------------------------------------------------------------- Event queue
# redis-streams = real queue (start Redis: docker compose -f infra/docker-compose.yml up -d)
# local (alias: local-directory) = development placeholder that writes JSON files; nothing consumes them
# There is no automatic fallback between the two.
QUEUE_PROVIDER=redis-streams
QUEUE_LOCAL_DIRECTORY=data/queue

# ---------------------------------------------------------------- Redis (only read when QUEUE_PROVIDER=redis-streams)
# host:port only - credentials go in REDIS_USER / REDIS_PASSWORD
REDIS_CONNECTION=localhost:6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_OPERATION_TIMEOUT_MS=3000
REDIS_EVENTS_STREAM=proctoring.audio.events.v1
REDIS_DLQ_STREAM=proctoring.audio.events.dlq.v1
REDIS_RESULTS_STREAM=proctoring.audio.results.v1
REDIS_RESULTS_DLQ_STREAM=proctoring.audio.results.dlq.v1
REDIS_AI_GROUP=ai-audio-processors
# Create the processing group on first publish so no event is skipped before the processor first starts
REDIS_CREATE_AI_GROUP=true
REDIS_BACKEND_GROUP=backend-results
# Approximate cap per stream (0 = never trim). Keep far above any expected backlog.
REDIS_STREAM_MAXLEN=100000
REDIS_UPDATES_CHANNEL=proctoring.audio.updates.v1

# ---------------------------------------------------------------- Results consumer (backend side of the results stream)
RESULTS_CONSUMER_ENABLED=true
RESULTS_CLAIM_IDLE_MS=60000
RESULTS_CLAIM_INTERVAL_MS=15000
RESULTS_MAX_DELIVERIES=3
RESULTS_READ_BATCH=10
RESULTS_POLL_MS=500

# ---------------------------------------------------------------- Live updates (SSE)
SSE_POLL_INTERVAL_MS=1000
SSE_HEARTBEAT_SECONDS=15
SSE_REAUTHORIZE_SECONDS=60
EVENT_UPDATES_RETENTION_HOURS=24

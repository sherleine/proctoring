# AI service settings. Copy to ai-service/.env (never commit .env). Real environment variables win.

# ---------------------------------------------------------------- Redis (same Redis as the backend)
REDIS_CONNECTION=localhost:6379
# Empty when Redis runs without a password (local docker compose default)
REDIS_PASSWORD=
REDIS_EVENTS_STREAM=proctoring.audio.events.v1
REDIS_RESULTS_STREAM=proctoring.audio.results.v1
REDIS_DLQ_STREAM=proctoring.audio.events.dlq.v1
REDIS_AI_GROUP=ai-audio-processors

# ---------------------------------------------------------------- Worker
# Default: <computer name>-<process id>. Set a fixed name if you want to see the same name in Redis.
AI_CONSUMER_NAME=
AI_WORKER_CONCURRENCY=1
# Retries: an entry that keeps failing is dead-lettered after this many deliveries
AI_MAX_DELIVERIES=3
# A pending entry idle this long (its worker crashed) is taken over
AI_CLAIM_IDLE_MS=60000

# ---------------------------------------------------------------- Shared audio storage
# The backend's AUDIO_STORE_PATH, seen from this service. Relative paths are resolved against the ai-service
# folder; the default is the backend's local development store. In Docker: /data/audio (read-only mount).
AUDIO_STORE_PATH=../backend/src/Proctoring.Api/data/audio

# ---------------------------------------------------------------- Models
# Silero VAD speech probability threshold (0..1)
VAD_THRESHOLD=0.5
# Speech-to-text with faster-whisper. false (default): events complete with verified speech segments only and
# the Whisper model is not loaded. true: also transcribe (settings below).
TRANSCRIPTION_ENABLED=false
# tiny | base | small | medium ... (downloaded once into the Hugging Face cache, HF_HOME)
WHISPER_MODEL=base
# cpu | cuda   (cuda needs requirements-gpu.txt; falls back to cpu if no CUDA device is usable)
WHISPER_DEVICE=cpu
# cpu: int8 | float32    cuda: float16 | int8_float16
WHISPER_COMPUTE_TYPE=int8
# Language spoken in the exam (en, de, fr ...). Empty = automatic detection, which is unreliable on short
# clips (one word can be detected as another language and transcribed as such) - set it when you know it.
WHISPER_LANGUAGE=en

LOG_LEVEL=INFO

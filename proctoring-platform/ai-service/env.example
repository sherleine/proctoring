# AI service settings. Copy to ai-service/.env (never commit .env). Real environment variables win.

# ---------------------------------------------------------------- Redis (same Redis as the backend)
REDIS_CONNECTION=localhost:6379
# Empty when Redis runs without a password (local docker compose default)
REDIS_PASSWORD=
REDIS_EVENTS_STREAM=proctoring.audio.events.v1
REDIS_RESULTS_STREAM=proctoring.audio.results.v1
REDIS_DLQ_STREAM=proctoring.audio.events.dlq.v1
REDIS_AI_GROUP=ai-audio-processors

# ---------------------------------------------------------------- Worker
# Default: <computer name>-<process id>. Set a fixed name if you want to see the same name in Redis.
AI_CONSUMER_NAME=
AI_WORKER_CONCURRENCY=1
# Retries: an entry that keeps failing is dead-lettered after this many deliveries
AI_MAX_DELIVERIES=3
# A pending entry idle this long (its worker crashed) is taken over
AI_CLAIM_IDLE_MS=60000

# ---------------------------------------------------------------- Shared audio storage
# The backend's AUDIO_STORE_PATH, seen from this service. Relative paths are resolved against the ai-service
# folder; the default is the backend's local development store. In Docker: /data/audio (read-only mount).
AUDIO_STORE_PATH=../backend/src/Proctoring.Api/data/audio

# ---------------------------------------------------------------- Models
# Silero VAD speech probability threshold (0..1)
VAD_THRESHOLD=0.5
# Speech-to-text with faster-whisper. false (default): events complete with verified speech segments only and
# the Whisper model is not loaded. true: also transcribe (settings below).
TRANSCRIPTION_ENABLED=false
# tiny | base | small | medium ... (downloaded once into the Hugging Face cache, HF_HOME)
WHISPER_MODEL=base
# cpu | cuda   (cuda needs requirements-gpu.txt; falls back to cpu if no CUDA device is usable)
WHISPER_DEVICE=cpu
# cpu: int8 | float32    cuda: float16 | int8_float16
WHISPER_COMPUTE_TYPE=int8
# Language spoken in the exam (en, de, fr ...). Empty = automatic detection, which is unreliable on short
# clips (one word can be detected as another language and transcribed as such) - set it when every candidate
# speaks the same language. Leave empty when candidates may speak in any language.
WHISPER_LANGUAGE=
# transcribe: output stays in the spoken language. translate: Whisper always outputs English text, whatever
# language was spoken, so the Tier 2 LLM always reviews an English transcript.
WHISPER_TASK=translate

LOG_LEVEL=INFO

# Voice comparison between the speakers of a clip (CAM++); thresholds calibrated on LibriSpeech
SPEAKER_ENABLED=true
SPEAKER_SAME_THRESHOLD=0.4028
SPEAKER_DIFFERENT_THRESHOLD=0.3188
SPEAKER_MIN_SEGMENT_SECONDS=1.5

# Speaker turns + overlap (pyannote.audio 4.1.1, community-1, segmentation step). Telemetry is always disabled.
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_REVISION=3533c8cf8e369892e6b79ff1bf80f7b0286a54ee
DIARIZATION_MIN_SPEECH_SECONDS=1.0
DIARIZATION_MIN_SPEAKER_SECONDS=1.0
DIARIZATION_MERGE_GAP_SECONDS=0.5
DIARIZATION_MIN_OVERLAP_SECONDS=0.5
DIARIZATION_THREADS=4
# Observation rules (docs/results/phase4-observations.md)
OVERLAP_MIN_SECONDS=1.0
MULTIPLE_FROM_OVERLAP=true
BACKGROUND_LEVEL_DB=10
ASSISTANCE_MIN_INDICATORS=2
# true: POSSIBLE_EXTERNAL_ASSISTANCE needs a transcript phrase (needs TRANSCRIPTION_ENABLED=true); voice-only evidence never counts
ASSISTANCE_REQUIRE_TRANSCRIPT=true
# Model cache (inside ai-service/models, ignored by git). After the first download set HF_HUB_OFFLINE=true.
HF_HOME=models/hf
HF_HUB_OFFLINE=false
# Read token of a Hugging Face account that accepted the community-1 conditions. Only needed for the first download.
# Put it ONLY in ai-service/.env (ignored by git) - never in this template.
HF_TOKEN=

# ---------------------------------------------------------------- Tier 2: LLM escalation (overlap/multiple-voices review)
# false (default): clips complete with Tier 1 observations only, no LLM involved.
ESCALATION_ENABLED=false
# vLLM's OpenAI-compatible endpoint (needs TRANSCRIPTION_ENABLED=true and DIARIZATION_ENABLED=true to have anything to send).
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=
# Bearer token for the LLM server, if it needs one (sent as "Authorization: Bearer <key>").
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
# Turns on Swagger at /docs for manual testing of POST /voice/verify (verbose=true returns the full AnalysisResult).
DEBUG_ANALYZE_ENDPOINT_ENABLED=false

# ---------------------------------------------------------------- POST /voice/verify (always on; needs DIARIZATION_ENABLED
# and the speaker model, see Speaker verification below, both enabled or it returns 503)
# How long a registered reference voice survives in Redis with no activity (seconds). Default 7 days.
VOICE_REFERENCE_TTL_SECONDS=604800

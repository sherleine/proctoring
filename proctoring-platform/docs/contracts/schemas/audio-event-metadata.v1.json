{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctoring.local/schemas/audio-event-metadata.v1.json",
  "title": "Audio event metadata v1 (browser -> backend upload)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "sequenceNumber", "part", "startedAt", "endedAt", "speechStartedAt", "durationSeconds", "preEventSeconds", "trigger", "audio", "video"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "format": "uuid", "description": "Generated by the client; makes uploads idempotent." },
    "eventType": { "const": "speech" },
    "sequenceNumber": { "type": "integer", "minimum": 0, "description": "Order of clips within the session." },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "index", "isFinal", "overlapSeconds"],
      "properties": {
        "groupId": { "type": "string", "format": "uuid", "description": "Same for all parts of one speech event." },
        "index": { "type": "integer", "minimum": 0 },
        "isFinal": { "type": "boolean" },
        "overlapSeconds": { "type": "number", "minimum": 0, "description": "Audio repeated from the previous part for context." }
      }
    },
    "startedAt": { "type": "string", "format": "date-time", "description": "First sample of the clip (includes pre-event audio)." },
    "endedAt": { "type": "string", "format": "date-time" },
    "speechStartedAt": { "type": "string", "format": "date-time", "description": "When VAD confirmed speech." },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
    "preEventSeconds": { "type": "number", "minimum": 0 },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "model", "startThreshold", "endThreshold", "maxProbability", "speechSeconds"],
      "properties": {
        "type": { "const": "vad" },
        "model": { "type": "string", "examples": ["silero-vad-v5"] },
        "startThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "endThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "speechSeconds": { "type": "number", "minimum": 0 },
        "noiseFloorDbfs": { "type": ["number", "null"] }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "codec", "sampleRate", "channels", "sizeBytes", "sha256"],
      "properties": {
        "format": { "const": "wav" },
        "codec": { "const": "pcm_s16le" },
        "sampleRate": { "const": 16000 },
        "channels": { "const": 1 },
        "sizeBytes": { "type": "integer", "minimum": 44 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordedLocally", "uploaded"],
      "properties": {
        "recordedLocally": { "type": "boolean" },
        "uploaded": { "type": "boolean", "description": "True only when the session policy allows video upload." },
        "format": { "const": "webm" },
        "codecs": { "type": "string", "examples": ["vp8,opus"] },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctoring.local/schemas/analysis-result.v1.json",
  "title": "Audio analysis result v1 (AI -> backend -> browser)",
  "description": "Every value comes from model output. Unavailable stages report available=false with a reason. Findings are observations for human review, not evidence of misconduct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "sessionId",
    "candidateId",
    "status",
    "processedAt",
    "processingMs",
    "models",
    "audio",
    "speech",
    "transcription",
    "diarization",
    "findings",
    "error"
  ],
  "$defs": {
    "stage": {
      "type": "object",
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "observation": {
      "type": "object",
      "description": "A potential observation for human review - never a determination of misconduct.",
      "additionalProperties": false,
      "required": [
        "observationId",
        "sessionId",
        "eventId",
        "observationType",
        "startSeconds",
        "endSeconds",
        "confidence",
        "confidenceKind",
        "supportingEvidence",
        "modelName",
        "modelVersion",
        "createdAt"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "format": "uuid",
          "description": "Deterministic from (eventId, observationType, startSeconds): redelivery never duplicates."
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "observationType": {
          "enum": [
            "MULTIPLE_SPEAKERS_DETECTED",
            "OVERLAPPING_SPEECH_DETECTED",
            "BACKGROUND_CONVERSATION_DETECTED",
            "NON_CANDIDATE_VOICE",
            "POSSIBLE_EXTERNAL_ASSISTANCE",
            "SPEECH_DETECTED",
            "NO_SPEECH_DETECTED",
            "PHONE_RINGING",
            "KEYBOARD_TYPING",
            "WHISPERING",
            "UNUSUAL_SOUND",
            "MULTIPLE_SPEAKERS",
            "OVERLAPPING_SPEECH",
            "BACKGROUND_CONVERSATION"
          ],
          "description": "Canonical names first. MULTIPLE_SPEAKERS, OVERLAPPING_SPEECH and BACKGROUND_CONVERSATION are deprecated aliases of the *_DETECTED names, still accepted for compatibility (not produced any more). SPEECH_DETECTED / NO_SPEECH_DETECTED are informational, never review flags."
        },
        "startSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Offset inside the event's audio clip."
        },
        "endSeconds": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidenceKind": {
          "enum": [
            "model-score",
            "calibrated-probability",
            "rule"
          ],
          "description": "model-score: a monotonic transform of a model score, NOT a probability."
        },
        "supportingEvidence": {
          "type": "object"
        },
        "modelName": {
          "type": "string",
          "maxLength": 128
        },
        "modelVersion": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "category": {
          "enum": [
            "informational",
            "review"
          ],
          "description": "informational: a neutral record (speech present / absent). review: a potential observation for a human reviewer. Absent = inferred from observationType (informational for SPEECH_DETECTED and NO_SPEECH_DETECTED, review otherwise)."
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "1.1 adds the optional enrolment, speaker and observations sections."
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string"
    },
    "candidateId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "processedAt": {
      "type": "string",
      "format": "date-time"
    },
    "processingMs": {
      "type": "number",
      "minimum": 0
    },
    "models": {
      "type": "object",
      "description": "Model identifiers actually used, e.g. {\"vad\":\"silero-vad-6.2\",\"asr\":\"faster-whisper:small\",\"diarization\":\"pyannote/speaker-diarization-community-1\"}",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "audio": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "durationSeconds",
        "sampleRate",
        "rmsDbfs",
        "peakDbfs"
      ],
      "properties": {
        "durationSeconds": {
          "type": "number"
        },
        "sampleRate": {
          "type": "integer"
        },
        "rmsDbfs": {
          "type": "number"
        },
        "peakDbfs": {
          "type": "number"
        }
      }
    },
    "speech": {
      "allOf": [
        {
          "$ref": "#/$defs/stage"
        }
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "speechSeconds": {
          "type": "number"
        },
        "speechRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        }
      }
    },
    "transcription": {
      "allOf": [
        {
          "$ref": "#/$defs/stage"
        }
      ],
      "properties": {
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "languageProbability": {
          "type": [
            "number",
            "null"
          ],
          "description": "As reported by the model."
        },
        "text": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/span"
              }
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "speaker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "avgLogprob": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Raw decoder statistic, not a calibrated confidence."
              },
              "noSpeechProb": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "diarization": {
      "allOf": [
        {
          "$ref": "#/$defs/stage"
        }
      ],
      "properties": {
        "speakerCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "turns": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/span"
              }
            ],
            "properties": {
              "speaker": {
                "type": "string"
              }
            },
            "required": [
              "speaker"
            ]
          }
        },
        "overlaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "speakers": {
          "type": "array",
          "description": "Contract 1.1 (optional): one entry per anonymous diarized speaker (S1, S2... by first appearance; never an identity). voice = CAM++ comparison of that speaker's non-overlapping speech with the enrolled candidate voice.",
          "items": {
            "type": "object",
            "required": [
              "speaker"
            ],
            "properties": {
              "speaker": {
                "type": "string"
              },
              "speechSeconds": {
                "type": "number"
              },
              "exclusiveSeconds": {
                "type": "number"
              },
              "rmsDbfs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "voice": {
                "enum": [
                  "LIKELY_CANDIDATE",
                  "LIKELY_NON_CANDIDATE",
                  "UNCERTAIN"
                ]
              }
            }
          }
        },
        "distinctVoices": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Contract 1.1 (optional): distinct voices supported by the voice comparison (diarized speakers that all match the candidate count as one); null when undecided."
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "severity",
          "description",
          "start",
          "end",
          "evidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "CANDIDATE_SPEECH",
              "MULTIPLE_VOICES",
              "BACKGROUND_CONVERSATION",
              "OVERLAPPING_SPEECH",
              "POSSIBLE_VERBAL_ASSISTANCE",
              "UNUSUAL_AUDIO",
              "NO_SPEECH_VERIFIED"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "review"
            ]
          },
          "description": {
            "type": "string"
          },
          "start": {
            "type": [
              "number",
              "null"
            ]
          },
          "end": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "description": "The measurements the rule used."
          }
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "deliveryCount": {
          "type": "integer"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "description": "Contract 1.1 (optional). Empty when nothing needs review."
    },
    "enrolment": {
      "type": [
        "object",
        "null"
      ],
      "description": "Contract 1.1 (optional): only for eventType=enrolment. The embedding travels only on the internal stream; the backend stores it separately and removes it before results reach browsers.",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "speechSeconds",
        "embedding",
        "embeddingModel"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "uncertain",
            "rejected"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechSeconds": {
          "type": "number",
          "minimum": 0
        },
        "windows": {
          "type": "integer",
          "minimum": 0
        },
        "selfConsistency": {
          "type": [
            "number",
            "null"
          ]
        },
        "minWindowSimilarity": {
          "type": [
            "number",
            "null"
          ]
        },
        "speechRmsDbfs": {
          "type": [
            "number",
            "null"
          ]
        },
        "clippedRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "embedding": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "maxItems": 4096
        },
        "embeddingStored": {
          "type": "boolean",
          "description": "Set by the backend after removing the embedding."
        },
        "embeddingModel": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "speaker": {
      "description": "Contract 1.1 (optional): comparison of speech regions with the candidate voice reference.",
      "allOf": [
        {
          "$ref": "#/$defs/stage"
        }
      ],
      "properties": {
        "reference": {
          "enum": [
            "present",
            "missing"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "thresholds": {
          "type": [
            "object",
            "null"
          ]
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "similarity",
              "decision"
            ],
            "properties": {
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "similarity": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "decision": {
                "enum": [
                  "LIKELY_CANDIDATE",
                  "LIKELY_NON_CANDIDATE",
                  "UNCERTAIN"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}

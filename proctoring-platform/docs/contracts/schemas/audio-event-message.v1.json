{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proctoring.local/schemas/audio-event-message.v1.json",
  "title": "audio.event.submitted payload v1 (backend -> AI)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "candidateId",
    "examId",
    "event",
    "audioRef"
  ],
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "candidateId": {
      "type": "string"
    },
    "examId": {
      "type": "string"
    },
    "event": {
      "$ref": "audio-event-metadata.v1.json"
    },
    "audioRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "uri",
        "sha256",
        "sizeBytes",
        "contentType"
      ],
      "properties": {
        "storage": {
          "enum": [
            "file",
            "s3"
          ]
        },
        "uri": {
          "type": "string",
          "pattern": "^(file|s3)://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 44
        },
        "contentType": {
          "const": "audio/wav"
        },
        "key": {
          "type": "string",
          "pattern": "^ses_[A-Za-z0-9]{20,36}/[a-f0-9]{32}\\.wav$",
          "description": "Added in 1.1 (optional): storage key relative to the audio store root. Consumers that mount the store elsewhere resolve the file from their own AUDIO_STORE_PATH + key instead of the backend's absolute uri."
        }
      }
    },
    "speakerReference": {
      "type": [
        "object",
        "null"
      ],
      "description": "Contract 1.1 (optional): the session's accepted candidate voice reference, added by the backend for speech events only. Biometric data: sent only on the internal stream, never to browsers.",
      "additionalProperties": false,
      "required": [
        "embedding",
        "model",
        "enrolmentEventId"
      ],
      "properties": {
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 16,
          "maxItems": 4096
        },
        "model": {
          "type": "string",
          "maxLength": 128
        },
        "enrolmentEventId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}

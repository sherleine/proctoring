# Each service has its own settings template - copy the one you run:
#   backend/.env.example     -> backend/.env       (.NET API: database, sessions, audio store, Redis, SSE)
#   ai-service/.env.example  -> ai-service/.env    (processing service, Phase 5)
#   frontend/.env.example    -> frontend/.env      (browser settings, Phase 6; never secrets)
#
# This root file is only for shared local infrastructure (infra/docker-compose.yml):
#   docker compose -f infra/docker-compose.yml --env-file .env up -d
#
# Compatibility: the backend still reads a root .env when no backend/.env exists (it uses the nearest
# .env above its working directory), so an existing root .env keeps working.

# ---------------------------------------------------------------- Redis (docker compose)
REDIS_PORT=6379
# Empty = no authentication (local only; the port is bound to 127.0.0.1). Set it, then use the same value
# as REDIS_PASSWORD in backend/.env and ai-service/.env.
REDIS_PASSWORD=

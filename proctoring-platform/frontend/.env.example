# Frontend settings. Copy to frontend/.env:   Copy-Item .env.example .env
# Every VITE_* value is bundled into the JavaScript sent to browsers: never put secrets here.
# (There are none: the browser authenticates with the per-session token the backend returns.)

# The .NET backend (its CORS_ORIGINS must contain http://localhost:5173)
VITE_API_BASE_URL=http://localhost:5080
# Demo identifiers sent when creating a session (letters, digits . _ : -)
VITE_CANDIDATE_ID=cand-demo
VITE_EXAM_ID=exam-demo

# Browser speech detection (Silero VAD). Clip timing (pre-roll, silence, max length, overlap) comes from the
# backend's recordingPolicy (RECORDING_* in backend/.env).
VITE_VAD_START_THRESHOLD=0.5
VITE_VAD_END_THRESHOLD=0.35
# Sounds with less speech than this never become events
VITE_VAD_MIN_SPEECH_MS=250
# Audio kept after the last speech (protects word endings); the rest of the closing silence is not saved
VITE_VAD_TAIL_PAD_MS=500
# Browser echo cancellation / noise suppression / automatic gain control on the microphone.
# Set false if speech is cut off or the level drops after you start talking (raw microphone signal).
VITE_MIC_AUDIO_PROCESSING=true

# Local storage (IndexedDB): clips older than this are deleted on start
VITE_LOCAL_RETENTION_DAYS=7
# Live updates: poll GET /events at this interval when the SSE stream is unavailable
VITE_UPDATES_POLL_FALLBACK_MS=4000
